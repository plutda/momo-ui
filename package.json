{
  "name": "momo-ui",
  "version": "0.1.0",
  "description": "🍬 Momo UI — 卡通风格的 Vue 3 基础组件库",
  "type": "module",
  "main": "./dist/momo-ui.umd.cjs",
  "module": "./dist/momo-ui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/momo-ui.js",
      "require": "./dist/momo-ui.umd.cjs"
    },
    "./style.css": "./dist/momo-ui.css"
  },
  "files": ["dist"],
  "sideEffects": ["**/*.css", "**/*.scss"],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "docs:dev": "vite",
    "docs:build": "vite build --config vite.site.config.ts",
    "docs:preview": "vite preview --config vite.site.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "keywords": ["vue3", "ui", "component-library", "cartoon", "momo"],
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "sass": "^1.83.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.4.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
